# Copia este archivo como .env y llena tus valores. Nunca subas .env a GitHub.

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=tu_token_de_BotFather

# --- Modelos de IA (capa gratuita; deja vacíos los que no uses) ------------------
# Orden = prioridad. Se consultan los primeros NLP_ENSEMBLE_SIZE disponibles; si uno
# falla (límite, caída, clave inválida) entra el siguiente. Si fallan todos, deciden las reglas.
NLP_PROVIDERS=groq,cerebras,openrouter,edenai
NLP_ENSEMBLE_SIZE=3

# Cada *_MODEL admite varios modelos separados por comas: si uno falla, se usa el siguiente.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,llama-3.1-8b-instant,qwen/qwen3.8-27b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b,llama3.1-8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
# Eden AI cobra de tu saldo de créditos: déjalo al final de NLP_PROVIDERS.
EDENAI_API_KEY=
EDENAI_MODEL=cohere/command-a-03-2025

# --- Política de moderación ------------------------------------------------
TOXICITY_THRESHOLD=0.70
# Umbral más estricto para sexismo, LGBTIQ+fobia, racismo, etc. (suelen venir sin groserías)
IDENTITY_HATE_THRESHOLD=0.55
CRISIS_THRESHOLD=0.50
HARD_BLOCK_THRESHOLD=0.90
# Advertencias antes de expulsar del grupo. 0 = nunca expulsar (solo borra y advierte).
MAX_WARNINGS=5
ALLOW_REPUBLISH=true
STORE_CRISIS_TEXT=false

# --- Panel -------------------------------------------------------------------
# Genera uno con: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Juan Pablo Monroy
LOG_LEVEL=INFO

# --- Solo en la nube (Vercel + QStash + Neon). En docker compose deja QUEUE_BACKEND=celery ---
QUEUE_BACKEND=celery
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
AUTO_MIGRATE=false
